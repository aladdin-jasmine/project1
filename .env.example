# StudyForge environment configuration.
# Everything is OPTIONAL. Leave blank to use the local JSON store / pure-JS fallbacks.

# PostgreSQL connection (enables relational analytics + audit log).
# Used only if reachable; otherwise the app stores everything in data/*.json.
DATABASE_URL=postgres://studyforge:studyforge@localhost:5432/studyforge

# ChromaDB vector database (enables a real vector DB for retrieval).
# Used only if reachable; otherwise retrieval uses the local JSON cosine store.
CHROMA_URL=http://localhost:8000

# Optional model download mirror for @xenova/transformers (local embeddings / reranker).
HF_HOME=

# Port the API server listens on.
PORT=5174
